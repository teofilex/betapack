{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "category", "value": "(?<category>.*)" }
      ],
      "destination": "/steel?category=:category",
      "statusCode": 301
    },
    {
      "source": "/proizvod/:slugOrId",
      "destination": "/steel/proizvod/:slugOrId",
      "statusCode": 301
    },
    {
      "source": "/order-success/:orderId",
      "destination": "/steel/order-success/:orderId",
      "statusCode": 301
    },
    { "source": "/o-nama", "destination": "/steel/o-nama", "statusCode": 301 },
    { "source": "/kontakt", "destination": "/steel/kontakt", "statusCode": 301 },
    { "source": "/cart", "destination": "/steel/cart", "statusCode": 301 },
    { "source": "/checkout", "destination": "/steel/checkout", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.betapack.co.rs/sitemap.xml"
    },
    { "source": "/steel/proizvod/:slug", "destination": "/spa.html" },
    { "source": "/steel/cart", "destination": "/spa.html" },
    { "source": "/steel/checkout", "destination": "/spa.html" },
    { "source": "/steel/order-success/:orderId", "destination": "/spa.html" },
    { "source": "/ambalaza/proizvod/:slug", "destination": "/spa.html" },
    { "source": "/ambalaza/cart", "destination": "/spa.html" },
    { "source": "/ambalaza/checkout", "destination": "/spa.html" },
    { "source": "/ambalaza/order-success/:orderId", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" }
  ]
}
